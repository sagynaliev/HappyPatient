# Sprint 4: unattended-slot scheduler interval (milliseconds; minimum 1000)
SLOT_RELEASE_INTERVAL_MS=60000
REMINDER_INTERVAL_MS=60000
REMINDER_LEAD_HOURS=24,2
INTEGRITY_INTERVAL_MS=86400000
# Admin demo clock (Admin -> Demo time). Set to off to disable.
TIME_CONTROL=on
