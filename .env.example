JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
RESET_TOKEN_EXPIRES_MINUTES=30
PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api
