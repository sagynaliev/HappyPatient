generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
  FRONT_DESK
}

enum SlotStatus {
  FREE
  BOOKED
  OCCUPIED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?  @unique
  iin          String?  @unique
  role         Role     @default(PATIENT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  doctor      Doctor?
  resetTokens ResetToken[]
  bookedSlots ScheduleSlot[] @relation("BookedSlots")
  notifications Notification[]
  receipts      Receipt[]
  checkInsPerformed ScheduleSlot[] @relation("CheckInsPerformed")
  cancelledVisits   CancelledAppointment[] @relation("CancelledVisits")
  cancellationsMade CancelledAppointment[] @relation("CancellationsMade")
}

model Doctor {
  id              String   @id @default(cuid())
  userId          String   @unique
  categoryId      String
  office          String?
  city            String?
  clinicName      String?
  streetAddress   String?
  officeNumber    String?
  consultationFee Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category       @relation(fields: [categoryId], references: [id])
  scheduleSlots ScheduleSlot[]
  cancellations CancelledAppointment[]
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  doctors Doctor[]
}

model ResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model ScheduleSlot {
  id           String     @id @default(cuid())
  doctorId     String
  patientId    String?
  startAt      DateTime
  endAt        DateTime
  status       SlotStatus @default(FREE)
  visitPurpose String?    @db.VarChar(300)
  checkedInAt  DateTime?
  checkedInById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  doctor  Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  patient User?  @relation("BookedSlots", fields: [patientId], references: [id], onDelete: SetNull)
  checkedInBy User? @relation("CheckInsPerformed", fields: [checkedInById], references: [id], onDelete: SetNull)
  notifications Notification[]
  receipt       Receipt?
  cancellations CancelledAppointment[]

  @@unique([doctorId, startAt])
  @@index([doctorId, startAt])
  @@index([patientId])
  @@index([checkedInById])
}

model Notification {
  id          String   @id @default(cuid())
  eventKey    String   @unique
  userId      String
  slotId      String?
  type        String
  channel     String
  status      String
  subject     String
  message     String
  error       String?
  createdAt   DateTime @default(now())
  deliveredAt DateTime?
  readAt      DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  slot ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([slotId])
}

model Receipt {
  id          String   @id @default(cuid())
  slotId      String   @unique
  patientId   String
  reference   String   @unique
  status      String   @default("READY")
  createdAt   DateTime @default(now())
  printedAt   DateTime?

  slot    ScheduleSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  patient User         @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

/// A booked visit that was cancelled. The slot itself is freed for other patients,
/// so the visit details and the reason are kept here for both sides' history.
model CancelledAppointment {
  id              String   @id @default(cuid())
  slotId          String?
  patientId       String
  doctorId        String
  startAt         DateTime
  endAt           DateTime
  visitPurpose    String?  @db.VarChar(300)
  reason          String   @db.VarChar(300)
  cancelledById   String?
  cancelledByRole Role
  createdAt       DateTime @default(now())

  slot        ScheduleSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  patient     User          @relation("CancelledVisits", fields: [patientId], references: [id], onDelete: Cascade)
  doctor      Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  cancelledBy User?         @relation("CancellationsMade", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}
